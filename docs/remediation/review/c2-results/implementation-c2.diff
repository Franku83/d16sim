+            if !v.is_finite() {
+                return Err(bad(name));
+            }
+        }
+        if self.r0_ohm < 0.0 || self.r_ground_ohm < 0.0 {
+            return Err(bad("resistance must be >= 0"));
+        }
+        Ok(())
