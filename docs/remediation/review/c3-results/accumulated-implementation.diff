+        let stored: f64 = w.cyls.iter().map(|c| c.fuel).sum::<f64>() + w.plen.fuel + w.exh.fuel;
+        let closure = f0 + w.fuel_injected_kg - (stored + w.fuel_burned_kg + w.fuel_emitted_kg);
+        assert!(closure.abs() < 1e-9, "fuel closure {closure}");
